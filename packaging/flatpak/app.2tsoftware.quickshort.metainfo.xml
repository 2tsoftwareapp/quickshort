<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.2tsoftware.quickshort</id>
  <name>Quickshort</name>
  <summary>Region screenshot tool with annotations and OCR</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <developer>
    <name>truongdq</name>
  </developer>
  <launchable type="desktop-id">app.2tsoftware.quickshort.desktop</launchable>
  <description>
    <p>
      Quickshort captures screen regions, windows and full monitors at native
      resolution, then lets you mark up the shot with arrows, text (including
      Vietnamese IME), blur and shapes before saving or sharing.
    </p>
    <p>
      It can record short MP4 clips, run on-device OCR, produce expiring share
      links, and keep an editable .qsdoc so annotations stay re-openable as
      layers. An evidence-session mode helps testers capture labelled step
      screenshots and merge them into a single contact sheet.
    </p>
  </description>
  <categories>
    <category>Utility</category>
    <category>Graphics</category>
  </categories>
  <keywords>
    <keyword>screenshot</keyword>
    <keyword>snip</keyword>
    <keyword>ocr</keyword>
    <keyword>annotate</keyword>
    <keyword>region</keyword>
  </keywords>
